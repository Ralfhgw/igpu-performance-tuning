    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst points = items[0]?.json?.result?.points ?? [];\n\nif (points.length === 0) {\n  return [{ json: { answer: 'Keine passenden Dokumente in der Wissensdatenbank gefunden.' } }];\n}\n\nconst uniqueFiles = [...new Set(points.map(p => (p.payload?.metadata?.filename) || 'unbekannt'))];\nconst fileList = uniqueFiles.map((f, i) => `${i + 1}. ${f}`).join('\\n');\n\nconst blocks = points.map((point, i) => {\n  const payload = point.payload || {};\n  const meta = payload.metadata || {};\n  const content = payload.content || '';\n  const score = point.score !== undefined ? point.score : '';\n  return `[Treffer ${i + 1}] (Score: ${score}, Datei: ${meta.filename || 'unbekannt'}, Titel: ${meta.title || ''})\\n${content}`;\n}).join('\\n\\n---\\n\\n');\n\nconst answer = `In der Wissensdatenbank abgespeicherte Dokumente (dedupliziert):\\n${fileList}\\n\\n---\\n\\nGefundene Textausschnitte:\\n\\n${blocks}`;\n\nreturn [{ json: { answer } }];"
      },
