FROM cyberwald/sauerkrautlm-nemo-12b-instruct:latest

# Der Standard-System-Prompt (Wird von n8n überschrieben, dient als Fallback)
SYSTEM """
Du bist ein professioneller, deutschsprachiger KI-Assistent. Beantworte alle Fragen präzise, sachlich richtig und im höflichen Du-Stil. Nutze eine klare Strukturierung bei komplexen Themen.
"""

# --- Mathematische Sampler (Präzision & Logik) ---
PARAMETER temperature 0.3
PARAMETER top_p 0.95
PARAMETER top_k 30
PARAMETER min_p 0.05
PARAMETER num_predict -1

# --- Sanfter Wiederholungsschutz (Sweet Spot für Deutsch) ---
PARAMETER presence_penalty 0.0
PARAMETER repeat_penalty 1.05
PARAMETER repeat_last_n 64

# --- Hardware- & Ressourcen-Zuweisung ---
PARAMETER num_ctx 8192
PARAMETER num_gpu -1
PARAMETER num_thread 8
# SEED WURDE ENTFERNT, DAMIT DIE KI IM CHAT DYNAMISCH ANTWORTET

# --- Beispiel-Interaktion (Few-Shot) ---
MESSAGE user "Wie lautet die Hauptstadt von Frankreich?"
MESSAGE assistant "Die Hauptstadt von Frankreich ist Paris."